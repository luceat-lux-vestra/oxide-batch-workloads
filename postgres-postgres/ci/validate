run_raw_sqlx_static_guards() {
  local raw_manifest="benchmark/raw-sqlx/Cargo.toml"
  local raw_source="benchmark/raw-sqlx/src/main.rs"

  echo "raw-sqlx guard: dependency graph contains no oxide-batch packages"
  if cargo tree --locked --manifest-path "$raw_manifest" | grep -E '(^| )oxide-batch([ -]|$)'; then
    echo "::error::raw-sqlx dependency graph must not contain oxide-batch*" >&2
    exit 1
  fi

  echo "raw-sqlx guard: production path has no whole-dataset fetch_all"
  if grep -nF '.fetch_all(' "$raw_source"; then
    echo "::error::raw-sqlx production source must not call .fetch_all(" >&2
    exit 1
  fi

  echo "raw-sqlx guard: production path never accesses framework-owned oxide_batch metadata"
  if grep -nE 'oxide_batch\.' "$raw_source"; then
    echo "::error::raw-sqlx must never read or mutate framework-owned oxide_batch.* metadata" >&2
    exit 1
  fi

  echo "raw-sqlx guard: cursor mode is an explicit server-side DECLARE/FETCH path"
  grep -qF 'NO SCROLL CURSOR' "$raw_source"
  grep -qF 'FETCH FORWARD' "$raw_source"

  echo "raw-sqlx guard: hard-death failpoint only pauses for an external parent SIGKILL"
  if grep -nE 'process::(abort|exit)|libc::kill' "$raw_source"; then
    echo "::error::raw-sqlx hard-death proof must not self-abort, self-exit, or self-signal" >&2
    exit 1
  fi
}

wait_for_raw_marker() {
  local marker="$1"
  local expected_pid="$2"
  local marker_pid=""
  local attempt

  for attempt in $(seq 1 300); do
    if [[ -s "$marker" ]]; then
      marker_pid="$(sed -n 's/^pid=\([0-9][0-9]*\) .*/\1/p' "$marker")"
      if [[ "$marker_pid" != "$expected_pid" ]]; then
        echo "::error::raw-sqlx marker PID '$marker_pid' did not match spawned PID '$expected_pid'" >&2
        cat "$marker" >&2 || true
        exit 1
      fi
      return 0
    fi
    sleep 0.1
  done

  echo "::error::timed out waiting for raw-sqlx external-kill marker $marker" >&2
  return 1
}

CRASHED_PID=""
crash_raw_at_marker() {
  local marker="$1"
  local log="$2"
  shift 2

  rm -f "$marker"
  "$RAW_SQLX_BIN" --database-url "$DATABASE_URL" run "$@" --pause-marker "$marker" >"$log" 2>&1 &
  local pid=$!
  wait_for_raw_marker "$marker" "$pid"

  kill -KILL "$pid"
  local status=0
  if wait "$pid"; then
    status=0
  else
    status=$?
  fi
  if [[ "$status" -ne 137 ]]; then
    echo "::error::raw-sqlx hard-death process exited with status $status, expected SIGKILL status 137" >&2
    cat "$log" >&2 || true
    exit 1
  fi
  CRASHED_PID="$pid"
}

run_raw_recovery_process() {
  local log="$1"
  shift

  "$RAW_SQLX_BIN" --database-url "$DATABASE_URL" run "$@" >"$log" 2>&1 &
  local recovery_pid=$!
  if [[ "$recovery_pid" == "$CRASHED_PID" ]]; then
    echo "::error::recovery must run in a genuinely new OS process" >&2
    exit 1
  fi
  if ! wait "$recovery_pid"; then
    echo "::error::raw-sqlx recovery process failed" >&2
    cat "$log" >&2 || true
    exit 1
  fi
}

hard_crash_recovery_case() {
  local reader="$1"
  local reader_size="$2"
  local phase="$3"
  local expected_rows_after_kill="$4"
  local expected_chunks_after_kill="$5"
  local import_name="$6"
  local mutation_check="${7:-false}"
  local size_flag

  case "$reader" in
    cursor) size_flag="--fetch-size" ;;
    paging) size_flag="--page-size" ;;
    *)
      echo "::error::unknown raw reader mode '$reader'" >&2
      exit 1
      ;;
  esac

  cargo run --locked -q -p postgres-postgres -- reset
  cargo run --locked -q -p postgres-postgres -- seed --rows 550 --seed 42

  local marker
  local crash_log
  local recovery_log
  marker="$(mktemp)"
  crash_log="$(mktemp)"
  recovery_log="$(mktemp)"

  crash_raw_at_marker \
    "$marker" \
    "$crash_log" \
    --import-name "$import_name" \
    --reader "$reader" \
    --chunk-size 100 \
    "$size_flag" "$reader_size" \
    --pause-at-chunk 3 \
    --pause-phase "$phase"

  assert_scalar \
    "SELECT count(*) FROM app_business.customer_projection WHERE import_name = '$import_name'" \
    "$expected_rows_after_kill"
  assert_scalar \
    "SELECT committed_rows FROM benchmark_raw.checkpoint WHERE import_name = '$import_name' AND reader_mode = '$reader'" \
    "$expected_rows_after_kill"
  assert_scalar \
    "SELECT committed_chunks FROM benchmark_raw.checkpoint WHERE import_name = '$import_name' AND reader_mode = '$reader'" \
    "$expected_chunks_after_kill"

  if [[ "$mutation_check" == "true" ]]; then
    echo "raw-sqlx source mutation: stale crashed checkpoint must fail closed"
    psql_exec \
      "UPDATE app_source.source_customer SET balance_cents = balance_cents + 1 \
       WHERE customer_id = (SELECT min(customer_id) FROM app_source.source_customer)"
    if "$RAW_SQLX_BIN" --database-url "$DATABASE_URL" run \
      --import-name "$import_name" \
      --reader "$reader" \
      --chunk-size 100 \
      "$size_flag" "$reader_size"; then
      echo "::error::raw-sqlx unexpectedly accepted a changed source against stale checkpoint state" >&2
      exit 1
    fi
    assert_scalar \
      "SELECT count(*) FROM benchmark_raw.checkpoint WHERE import_name = '$import_name' AND reader_mode = '$reader'" \
      "1"
    assert_scalar \
      "SELECT count(*) FROM app_business.customer_projection WHERE import_name = '$import_name'" \
      "$expected_rows_after_kill"
    psql_exec \
      "UPDATE app_source.source_customer SET balance_cents = balance_cents - 1 \
       WHERE customer_id = (SELECT min(customer_id) FROM app_source.source_customer)"
  fi

  run_raw_recovery_process \
    "$recovery_log" \
    --import-name "$import_name" \
    --reader "$reader" \
    --chunk-size 100 \
    "$size_flag" "$reader_size"

  cargo run --locked -q -p postgres-postgres -- verify --import-name "$import_name"
  assert_scalar \
    "SELECT count(*) FROM app_business.customer_projection WHERE import_name = '$import_name'" \
    "550"
  assert_scalar \
    "SELECT committed_rows FROM benchmark_raw.checkpoint WHERE import_name = '$import_name' AND reader_mode = '$reader'" \
    "550"
  assert_scalar \
    "SELECT committed_chunks FROM benchmark_raw.checkpoint WHERE import_name = '$import_name' AND reader_mode = '$reader'" \
    "6"

  rm -f "$marker" "$crash_log" "$recovery_log"
}

