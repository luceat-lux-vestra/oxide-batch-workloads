#!/usr/bin/env bash
# Workload-owned CI contract entrypoint for postgres-postgres.
# See ../../.github/WORKLOAD_CONTRACT.md for the contract this implements.
#
# This script is the ONLY place that knows postgres-postgres needs
# PostgreSQL, what its DATABASE_URL is, how it migrates, and what its smoke
# sequence is. The central workflow only ever runs `ci/validate <ci|msrv>`.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

stage="${1:?usage: ci/validate <ci|msrv>}"

export DATABASE_URL="postgresql://oxide_batch_workload:oxide_batch_workload@localhost:5434/postgres_postgres_workload"
export POSTGRES_POSTGRES_TEST_DATABASE_URL="$DATABASE_URL"

if docker compose version >/dev/null 2>&1; then
  compose() { docker compose "$@"; }
else
  compose() { docker-compose "$@"; }
fi

start_postgres() {
  compose up -d --wait --wait-timeout 60
}

stop_postgres() {
  compose down --volumes
}

run_ci_stage() {
  cargo fmt --check
  cargo clippy --locked --all-targets -- -D warnings
  cargo build --locked --all-targets

  echo "guard: no unguarded unwrap/expect on the production path"
  if grep -rnE '\.(unwrap|expect)\(' src/; then
    echo "::error::found .unwrap()/.expect() in src/" >&2
    exit 1
  fi

  trap stop_postgres EXIT
  start_postgres

  cargo run --locked -q -- migrate
  cargo test --locked -- --test-threads=1

  echo "golden-path smoke: reset -> seed -> run (cursor) -> verify"
  cargo run --locked -q -- reset
  cargo run --locked -q -- seed --rows 2000 --seed 42
  cargo run --locked -q -- run --import-name ci_smoke_cursor --chunk-size 200 --reader cursor --fetch-size 128
  cargo run --locked -q -- verify --import-name ci_smoke_cursor

  echo "golden-path smoke: run (paging) -> verify"
  cargo run --locked -q -- run --import-name ci_smoke_paging --chunk-size 200 --reader paging --page-size 128
  cargo run --locked -q -- verify --import-name ci_smoke_paging
}

run_msrv_stage() {
  # Matches csv-postgres's dedicated msrv stage: a locked build of all
  # targets at the declared toolchain, no database required.
  cargo build --locked --all-targets
}

case "$stage" in
  ci)
    run_ci_stage
    ;;
  msrv)
    run_msrv_stage
    ;;
  *)
    echo "unknown stage: $stage" >&2
    exit 1
    ;;
esac
