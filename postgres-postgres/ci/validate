#!/usr/bin/env bash
# Workload-owned CI contract entrypoint for postgres-postgres.
# See ../../.github/WORKLOAD_CONTRACT.md for the contract this implements.
#
# This script is the ONLY place that knows postgres-postgres needs
# PostgreSQL, what its DATABASE_URL is, how it migrates, and what its smoke
# sequence is. The central workflow only ever runs `ci/validate <ci|msrv>`.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

stage="${1:?usage: ci/validate <ci|msrv>}"

export DATABASE_URL="postgresql://oxide_batch_workload:oxide_batch_workload@localhost:5434/postgres_postgres_workload"
export POSTGRES_POSTGRES_TEST_DATABASE_URL="$DATABASE_URL"

if docker compose version >/dev/null 2>&1; then
  compose() { docker compose "$@"; }
else
  compose() { docker-compose "$@"; }
fi

start_postgres() {
  compose up -d --wait --wait-timeout 60
}

stop_postgres() {
  compose down --volumes
}

psql_scalar() {
  compose exec -T postgres psql \
    -U oxide_batch_workload \
    -d postgres_postgres_workload \
    -Atqc "$1"
}

assert_scalar() {
  local sql="$1"
  local expected="$2"
  local actual
  actual="$(psql_scalar "$sql")"
  if [[ "$actual" != "$expected" ]]; then
    echo "::error::SQL assertion failed: expected '$expected', got '$actual' for: $sql" >&2
    exit 1
  fi
}

run_raw_sqlx_static_guards() {
  local raw_manifest="benchmark/raw-sqlx/Cargo.toml"
  local raw_source="benchmark/raw-sqlx/src/main.rs"

  echo "raw-sqlx guard: dependency graph contains no oxide-batch packages"
  if cargo tree --locked --manifest-path "$raw_manifest" | grep -E '(^| )oxide-batch([ -]|$)'; then
    echo "::error::raw-sqlx dependency graph must not contain oxide-batch*" >&2
    exit 1
  fi

  echo "raw-sqlx guard: production path has no whole-dataset fetch_all"
  if grep -nF '.fetch_all(' "$raw_source"; then
    echo "::error::raw-sqlx production source must not call .fetch_all(" >&2
    exit 1
  fi

  echo "raw-sqlx guard: production path never accesses framework-owned oxide_batch metadata"
  if grep -nE 'oxide_batch\.' "$raw_source"; then
    echo "::error::raw-sqlx must never read or mutate framework-owned oxide_batch.* metadata" >&2
    exit 1
  fi
}

run_raw_sqlx_database_checks() {
  echo "raw-sqlx smoke: cross-page buffering + partial final chunk -> independent verifier"
  cargo run --locked -q -p postgres-postgres -- reset
  cargo run --locked -q -p postgres-postgres -- seed --rows 2051 --seed 42
  cargo run --locked -q -p raw-sqlx -- --database-url "$DATABASE_URL" migrate
  cargo run --locked -q -p raw-sqlx -- \
    --database-url "$DATABASE_URL" run \
    --import-name raw_ci_clean \
    --chunk-size 200 \
    --page-size 128
  cargo run --locked -q -p postgres-postgres -- verify --import-name raw_ci_clean
  assert_scalar \
    "SELECT count(*) FROM app_business.customer_projection WHERE import_name = 'raw_ci_clean'" \
    "2051"
  assert_scalar \
    "SELECT committed_rows FROM benchmark_raw.paging_checkpoint WHERE import_name = 'raw_ci_clean'" \
    "2051"

  echo "raw-sqlx rollback: second chunk failure preserves only the first committed prefix"
  cargo run --locked -q -p postgres-postgres -- reset
  cargo run --locked -q -p postgres-postgres -- seed --rows 451 --seed 42
  if cargo run --locked -q -p raw-sqlx -- \
    --database-url "$DATABASE_URL" run \
    --import-name raw_ci_rollback \
    --chunk-size 200 \
    --page-size 128 \
    --fail-after-chunk 2; then
    echo "::error::raw-sqlx injected rollback run unexpectedly succeeded" >&2
    exit 1
  fi
  assert_scalar \
    "SELECT count(*) FROM app_business.customer_projection WHERE import_name = 'raw_ci_rollback'" \
    "200"
  assert_scalar \
    "SELECT committed_rows FROM benchmark_raw.paging_checkpoint WHERE import_name = 'raw_ci_rollback'" \
    "200"
  assert_scalar \
    "SELECT committed_chunks FROM benchmark_raw.paging_checkpoint WHERE import_name = 'raw_ci_rollback'" \
    "1"

  echo "raw-sqlx typed-failure continuation: resume from durable prefix and verify partial tail"
  cargo run --locked -q -p raw-sqlx -- \
    --database-url "$DATABASE_URL" run \
    --import-name raw_ci_rollback \
    --chunk-size 200 \
    --page-size 128
  cargo run --locked -q -p postgres-postgres -- verify --import-name raw_ci_rollback
  assert_scalar \
    "SELECT count(*) FROM app_business.customer_projection WHERE import_name = 'raw_ci_rollback'" \
    "451"
  assert_scalar \
    "SELECT committed_rows FROM benchmark_raw.paging_checkpoint WHERE import_name = 'raw_ci_rollback'" \
    "451"
}

run_ci_stage() {
  cargo fmt --check --all
  cargo clippy --locked --workspace --all-targets -- -D warnings
  cargo build --locked --workspace --all-targets

  echo "guard: no unguarded unwrap/expect on the production path"
  if grep -rnE '\.(unwrap|expect)\(' src/; then
    echo "::error::found .unwrap()/.expect() in src/" >&2
    exit 1
  fi

  run_raw_sqlx_static_guards

  echo "retained-evidence verifier adversarial tests"
  python3 validation/test_verify_retained_evidence.py

  trap stop_postgres EXIT
  start_postgres

  cargo run --locked -q -p postgres-postgres -- migrate
  cargo test --locked --workspace -- --test-threads=1

  echo "golden-path smoke: reset -> seed -> run (cursor) -> verify"
  cargo run --locked -q -p postgres-postgres -- reset
  cargo run --locked -q -p postgres-postgres -- seed --rows 2000 --seed 42
  cargo run --locked -q -p postgres-postgres -- run --import-name ci_smoke_cursor --chunk-size 200 --reader cursor --fetch-size 128
  cargo run --locked -q -p postgres-postgres -- verify --import-name ci_smoke_cursor

  echo "golden-path smoke: run (paging) -> verify"
  cargo run --locked -q -p postgres-postgres -- run --import-name ci_smoke_paging --chunk-size 200 --reader paging --page-size 128
  cargo run --locked -q -p postgres-postgres -- verify --import-name ci_smoke_paging

  run_raw_sqlx_database_checks
}

run_msrv_stage() {
  # Both workspace members declare the same MSRV. The locked workspace build
  # proves the raw comparison crate cannot silently escape the workload's
  # published toolchain contract.
  cargo build --locked --workspace --all-targets
}

case "$stage" in
  ci)
    run_ci_stage
    ;;
  msrv)
    run_msrv_stage
    ;;
  *)
    echo "unknown stage: $stage" >&2
    exit 1
    ;;
esac
